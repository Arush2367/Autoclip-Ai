# Upload limits and optional storage overrides
AUTOCLIPS_MAX_UPLOAD_MB=2048
# AUTOCLIPS_STORAGE=C:/AutoClips-AI/storage
# AUTOCLIPS_DATABASE=C:/AutoClips-AI/storage/autoclips.sqlite3

# Local speech recognition. CPU/int8 is the safe default for the first Windows build.
AUTOCLIPS_WHISPER_MODEL=base
AUTOCLIPS_WHISPER_DEVICE=cpu
AUTOCLIPS_WHISPER_COMPUTE_TYPE=int8

# Meta developer app configuration.
# Leave blank for this preparation phase; the next phase will wire OAuth and API calls.
# Never commit real values or share the app secret.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
