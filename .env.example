# AutoClips AI local configuration
AUTOCLIPS_MAX_UPLOAD_MB=2048
# AUTOCLIPS_STORAGE=C:/AutoClips-AI/storage
# AUTOCLIPS_DATABASE=C:/AutoClips-AI/storage/autoclips.sqlite3

# Local speech recognition. CPU/int8 is the safe default for Windows.
AUTOCLIPS_WHISPER_MODEL=base
AUTOCLIPS_WHISPER_DEVICE=cpu
AUTOCLIPS_WHISPER_COMPUTE_TYPE=int8

# Meta Graph API version. Instagram Unified Login and Facebook Page tokens are
# entered in the local dashboard and stored in ignored storage/secrets/meta_auth.json.
META_GRAPH_API_VERSION=v27.0

# Meta app credentials are required only to validate Facebook Page tokens.
# Keep the real values in your local .env file; never commit them.
# META_APP_ID=
# META_APP_SECRET=
